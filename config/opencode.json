{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "sumopod/glm-5.3-flash",
  "small_model": "sumopod/glm-5.3-flash",
  "default_agent": "build",
  "lsp": false,
  "snapshot": false,
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.runtime/**",
      "**/target/**",
      "**/logs/**",
      "**/.git/**",
      "**/graphify-out/**"
    ]
  },
  "provider": {
    "sumopod": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SumoPod",
      "options": {
        "baseURL": "{env:SUMOPOD_BASE_URL}",
        "apiKey": "{env:SUMOPOD_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        }
      }
    }
  },
  "instructions": [
    "/opt/engine/agent.md"
  ],
  "plugin": [
    "file:///home/node/.config/opencode/node_modules/@razroo/opencode-model-fallback/dist/index.js",
    "file:///home/node/.config/opencode/node_modules/@tarquinen/opencode-dcp/dist/index.js",
    "file:///home/node/.config/opencode/node_modules/opencode-websearch-cited/dist/index.js"
  ],
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 20000
  },
  "permission": {
    "*": "allow",
    "lean-ctx_*": "allow"
  },
  "agent": {
    "build": {
      "model": "opencode/big-pickle",
      "fallback_models": [],
      "max_tokens": 32000,
      "mode": "primary"
    },
    "tech-lead": {
      "description": "Scrum team lead and primary orchestrator — delegates to the team, runs the scoring pipeline, drives the state machine.",
      "mode": "primary",
      "model": "sumopod/glm-5.3-flash",
      "fallback_models": [],
      "max_tokens": 4096,
      "temperature": 0,
      "top_p": 1,
      "steps": 50,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "deny",
        "grep": "deny",
        "glob": "deny",
        "list": "deny",
        "write": "deny",
        "webfetch": "deny",
        "lean-ctx_*": "allow",
        "context7_*": "allow",
        "memory_*": "allow"
      }
    },
    "ui-ux-tech-lead": {
      "description": "UI/UX specialist orchestrator — enforces 4-layer design pipeline (Exemplar > Generator > Taste > Gate).",
      "mode": "primary",
      "model": "sumopod/glm-5.3-flash",
      "fallback_models": [],
      "max_tokens": 4096,
      "temperature": 0.2,
      "top_p": 1,
      "steps": 50,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "deny",
        "grep": "deny",
        "glob": "deny",
        "list": "deny",
        "write": "deny",
        "webfetch": "deny",
        "skill": "allow",
        "task": {
          "*": "allow"
        },
        "lean-ctx_*": "allow",
        "context7_*": "allow",
        "memory_*": "allow"
      }
    },
    "product-manager": {
      "description": "Owns requirements and the acceptance-criteria backlog. Turns user intent into testable Given-When-Then criteria. Read-only — no edits.",
      "mode": "subagent",
      "model": "sumopod/deepseek-flash",
      "fallback_models": [],
      "max_tokens": 8192,
      "temperature": 0,
      "top_p": 1,
      "steps": 40,
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "write": "deny",
        "webfetch": "deny",
        "question": "deny",
        "context7_*": "allow",
        "memory_*": "allow",
        "lean-ctx_*": "allow"
      }
    },
    "scrum-master": {
      "description": "Process owner. Guards the contract, state machine, and workflow on every transition; unblocks BLOCKED sessions and drives retros. Read-only — no edits.",
      "mode": "subagent",
      "model": "sumopod/deepseek-flash",
      "fallback_models": [],
      "max_tokens": 4096,
