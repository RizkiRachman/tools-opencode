  "mcp": {
    "lean-ctx": {
      "type": "local",
      "command": [
        "lean-ctx"
      ],
      "enabled": true,
      "environment": {
        "LEAN_CTX_DATA_DIR": "/home/node/.local/share/opencode/lean-ctx"
      }
    },
    "graphify": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec graphify-mcp --graph \"${GRAPHIFY_GRAPH:-${GRAPHIFY_ROOT:-/home/node/workspace}/graphify-out/graph.json}\""
      ],
      "enabled": false,
      "environment": {
        "OPENAI_API_KEY": "{env:SUMOPOD_API_KEY}",
        "OPENAI_BASE_URL": "{env:SUMOPOD_BASE_URL}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "mcp-server-memory"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "mcp-server-fetch"
      ],
      "enabled": true
    },
    "everything": {
      "type": "local",
      "command": [
        "mcp-server-everything"
      ],
      "enabled": true
    }
  }
